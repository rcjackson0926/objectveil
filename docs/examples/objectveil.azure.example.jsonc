{
  // Production-oriented Azure Blob Storage example.
  //
  // What you actually need to change to go live: every "REPLACE-ME" value
  // below (paths, storage account/container, credentials) — the thread/packing
  // knobs are pre-tuned and should not need touching for a typical deployment.
  // See docs/CONFIGURATION.md for the full field reference and
  // docs/TUNING.md if your workload is heavily write- or read-skewed enough
  // to want different thread counts than the balanced defaults below.
  //
  // Storage layout:
  //   - primary: Azure, data container (chunks/catalog/standalone objects)
  //   - keystore: Azure, a SEPARATE container for crypto-shred keys —
  //     REQUIRED for any cloud primary. Must be its own container with
  //     versioning / soft-delete all OFF (a key overwrite has to actually
  //     destroy bytes). Azure sets both per STORAGE ACCOUNT, not per
  //     container: if the data account keeps versions or deleted blobs, put
  //     the keystore in a separate account. See
  //     docs/design/object-storage-best-practices.md.
  //   - secondary: OPTIONAL, explicitly owned native ObjectVeil storage.
  //     It must carry the same namespace and supported current catalog/key
  //     dependencies. It is NOT an unconverted archive-root fallback and may
  //     receive deletions or reconciliation. Remove the block if not provisioned.

  "format": "objectveil/1",
  // REPLACE-ME: generate one UUID per deployment and use it on every cache
  // sharing this data/key namespace. The nil placeholder is rejected.
  "namespace_id": "00000000-0000-0000-0000-000000000000",
  "depot_path": "/mnt/perforce/depots/depot",  // REPLACE-ME
  "read_only": false,

  "max_cache_gb": 4096,        // REPLACE-ME: size to your local NVMe
  "low_watermark_gb": 3276,    // ~80% of max_cache_gb

  // Thread/packing settings below are pre-tuned recommended values — see
  // docs/TUNING.md and docs/design/cold-read-chunk-packing.md for the
  // operating tradeoffs for each. Only revisit them if your workload is
  // strongly write-only or read-only (TUNING.md's "workload shapes" table).
  "upload_threads": 16,
  "restore_threads": 32,
  "restore_chunk_threshold_mb": 8,
  "restore_chunk_threads": 8,
  "pack_target_chunk_bytes": 67108864,
  "pack_max_file_bytes": 8388608,
  "pack_flush_deadline_secs": 30,
  "compaction_live_fraction": 0.5,

  "primary": {
    "type": "azure",
    "account_name": "REPLACE-ME",
    "container": "REPLACE-ME-objectveil-data",
    "sas_token": "REPLACE-ME",   // or set "account_key" instead (use one, not both);
                                 // omit both to use the host's managed identity.
                                 // AZURE_CLIENT_ID/SECRET/TENANT_ID are NOT read.
    "path_prefix": "depot"
    // For a private/custom Azure endpoint instead of the public one, add:
    //   "endpoint": "https://REPLACE-ME.blob.core.windows.net",
    //   "endpoint_pin": true
    // NOTE: verify_ssl: false and ca_cert_path are REJECTED at config load (not
    // silently ignored) — the object_store-backed Azure client doesn't honour
    // either. Leave verify_ssl at its default; configure TLS trust on the Azure side.
  },

  "keystore": {
    "type": "azure",
    "account_name": "REPLACE-ME",
    "container": "REPLACE-ME-objectveil-keystore",  // MUST differ from primary's container
    "sas_token": "REPLACE-ME",
    "path_prefix": "depot"
  },

  "secondary": {
    // Optional native restore fallback; this is not a mirror or source archive.
    // Remove this entire block unless a matching native store is provisioned.
    "type": "nfs",
    "path": "/srv/objectveil-secondary-objects"  // REPLACE-ME (or delete block)
  },

  "skip_startup_scan": false,
  "stats_interval_secs": 60,
  "daemon": false,
  "verbose": false,

  "pid_file": "/run/objectveil/objectveil.pid",
  "log_file": "/var/log/objectveil/objectveil.log",

  "metrics_file": "/var/lib/node_exporter/textfile_collector/objectveil.prom",
  "metrics_interval_secs": 15,

  // Set to true and configure access_es_url or access_pg_url (see
  // docs/CONFIGURATION.md) if you want access-log analytics. Left off here
  // so this config loads with no external log-sink dependency.
  "access_log_enabled": false,

  // JSON does not allow octal integer literals. 432 decimal == 0660.
  "shim_socket_mode": 432,
  "access_socket_mode": 432
}
